{
  "name": "sound-desk",
  "private": true,
  "version": "0.1.0",
  "description": "SoundDesk — local-first AI audio asset manager (web tool + VSCode extension)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "check:encoding": "node tools/check-encoding.mjs",
    "dev": "pnpm --filter @sounddesk/engine dev",
    "start": "pnpm --filter @sounddesk/engine start",
    "clean": "node scripts/clean.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "node-web-audio-api": "^2.2.0",
    "typescript": "^5.7.2"
  }
}
