{
  "name": "@sounddesk/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SoundDesk workbench UI. One build runs in two hosts: a plain browser and the VSCode webview.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import ../../tools/register.mjs --experimental-strip-types --test \"src/**/*.test.ts\"",
    "check:popover": "node scripts/popover-layout.mjs",
    "check:provenance": "node scripts/check-hit-provenance.mjs"
  },
  "dependencies": {
    "@sounddesk/audio-effects": "workspace:*",
    "@sounddesk/core": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "vite": "^8.0.0"
  }
}
