{
  "name": "@sounddesk/audio-wav",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import ../../tools/register.mjs --test --experimental-strip-types \"src/*.test.ts\" \"test/*.test.ts\"",
    "test:direct": "node --import ../../tools/register.mjs --experimental-strip-types test/writer.test.ts"
  }
}
