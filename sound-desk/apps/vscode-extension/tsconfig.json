{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vscode"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "paths": {
      "@sounddesk/core": ["../../packages/core/dist/index.d.ts"],
      "@sounddesk/ucs": ["../../packages/ucs/dist/index.d.ts"],
      "@sounddesk/audio-wav": ["../../packages/audio-wav/dist/index.d.ts"],
      "@sounddesk/engine": ["../../packages/engine/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
