{
  "name": "dsh-csv-table",
  "displayName": "CSV 表格视图",
  "description": "以表格形式查看与编辑 .csv/.tsv 文件，并在页签栏一键切换表格视图与文本模式（类似 Markdown 的预览 / 文本切换）。",
  "version": "0.1.0",
  "publisher": "dsh-toolkit",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/FunsinGame/dsh-toolkit.git",
    "directory": "dsh-csv-table"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "csv",
    "tsv",
    "table",
    "viewer",
    "spreadsheet",
    "editor"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:csvExplorer.files"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true,
      "description": "表格视图读取 VS Code 提供的文本文档，因此虚拟工作区中的 CSV 也能显示。"
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "csvExplorer",
          "title": "CSV 配置表",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "csvExplorer": [
        {
          "id": "csvExplorer.files",
          "name": "CSV 配置表",
          "icon": "media/activity.svg"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "dshCsv.table",
        "displayName": "CSV 表格视图",
        "selector": [
          {
            "filenamePattern": "*.csv"
          },
          {
            "filenamePattern": "*.tsv"
          },
          {
            "filenamePattern": "*.tab"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "dshCsv.openInTable",
        "title": "打开表格视图",
        "category": "CSV",
        "icon": "$(table)"
      },
      {
        "command": "dshCsv.refreshFiles",
        "title": "刷新 CSV 列表",
        "category": "CSV",
        "icon": "$(refresh)"
      },
      {
        "command": "dshCsv.openFileInTable",
        "title": "打开表格视图",
        "category": "CSV",
        "icon": "$(table)"
      },
      {
        "command": "dshCsv.revealInOs",
        "title": "在文件资源管理器中显示",
        "category": "CSV",
        "icon": "$(link-external)"
      },
      {
        "command": "dshCsv.revealInExplorer",
        "title": "在侧边资源管理器中显示",
        "category": "CSV",
        "icon": "$(list-tree)"
      },
      {
        "command": "dshCsv.copyPath",
        "title": "复制路径",
        "category": "CSV",
        "icon": "$(copy)"
      },
      {
        "command": "dshCsv.showTable",
        "title": "表格视图",
        "category": "CSV",
        "icon": "$(table)"
      },
      {
        "command": "dshCsv.showText",
        "title": "文本模式",
        "category": "CSV",
        "icon": "$(code)"
      },
      {
        "command": "dshCsv.toggleView",
        "title": "切换表格视图 / 文本模式",
        "category": "CSV",
        "icon": "$(sync)"
      },
      {
        "command": "dshCsv.toggleDefaultEditor",
        "title": "设置或取消：.csv 默认用表格视图打开",
        "category": "CSV"
      },
      {
        "command": "dshCsv.revealTarget",
        "title": "定位到引用表",
        "category": "CSV",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "dshCsv.refreshFiles",
          "when": "view == csvExplorer.files",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "dshCsv.openFileInTable",
          "when": "view == csvExplorer.files && viewItem == dshCsv.file",
          "group": "inline@1"
        },
        {
          "command": "dshCsv.revealInOs",
          "when": "view == csvExplorer.files && viewItem == dshCsv.file",
          "group": "navigation@1"
        },
        {
          "command": "dshCsv.revealInExplorer",
          "when": "view == csvExplorer.files && viewItem == dshCsv.file",
          "group": "navigation@2"
        },
        {
          "command": "dshCsv.copyPath",
          "when": "view == csvExplorer.files && viewItem == dshCsv.file",
          "group": "navigation@3"
        }
      ],
      "editor/title": [
        {
          "command": "dshCsv.showTable",
          "when": "dshCsv.canShowTable && !dshCsv.tableActive",
          "group": "navigation@10"
        },
        {
          "command": "dshCsv.showText",
          "when": "dshCsv.canShowTable && dshCsv.tableActive",
          "group": "navigation@10"
        }
      ],
      "commandPalette": [
        {
          "command": "dshCsv.showTable",
          "when": "dshCsv.canShowTable"
        },
        {
          "command": "dshCsv.showText",
          "when": "dshCsv.canShowTable"
        },
        {
          "command": "dshCsv.toggleView",
          "when": "dshCsv.canShowTable"
        },
        {
          "command": "dshCsv.openFileInTable",
          "when": "false"
        },
        {
          "command": "dshCsv.revealTarget",
          "when": "dshCsv.canRevealTarget"
        }
      ],
      "explorer/context": [
        {
          "command": "dshCsv.showTable",
          "when": "resourceExtname == .csv || resourceExtname == .tsv || resourceExtname == .tab",
          "group": "navigation@9"
        }
      ]
    },
    "keybindings": [
      {
        "command": "dshCsv.toggleView",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "dshCsv.canShowTable"
      }
    ],
    "configuration": {
      "title": "CSV 表格视图",
      "properties": {
        "dshCsv.delimiter": {
          "type": "string",
          "enum": [
            "auto",
            ",",
            ";",
            "\t",
            "|"
          ],
          "enumDescriptions": [
            "按内容自动检测字段分隔符。",
            "逗号",
            "分号",
            "制表符",
            "竖线"
          ],
          "default": "auto",
          "markdownDescription": "字段分隔符。`auto` 按文件内容自动检测（默认）。分隔符即写回文件时使用的分隔符。"
        },
        "dshCsv.header": {
          "type": "string",
          "enum": [
            "auto",
            "yes",
            "no"
          ],
          "enumDescriptions": [
            "当首行看起来像标题行时把它固定为表头。",
            "首行始终是表头。",
            "首行是数据行。"
          ],
          "default": "auto",
          "markdownDescription": "首行是否为表头。表头行在按列排序时保持在第一行不动；表格顶部的固定条始终只显示列号。"
        },
        "dshCsv.maxRows": {
          "type": "number",
          "default": 20000,
          "minimum": 10,
          "markdownDescription": "表格视图最多渲染的数据行数。超过该行数的文件以只读方式显示前 N 行，避免阻塞编辑器。"
        },
        "dshCsv.columnWidth.max": {
          "type": "number",
          "default": 480,
          "minimum": 60,
          "markdownDescription": "自动列宽的上限（像素）。"
        },
        "dshCsv.frozenRows": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "锁定的行数：表格视图顶部固定显示前 N 行，滚动时不移动。在表格视图工具栏里修改会写回这一项用户设置，下一次打开任何 CSV 都会沿用。"
        },
        "dshCsv.frozenColumns": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "markdownDescription": "锁定的列数：表格视图左侧固定显示前 N 列，横向滚动时不移动。在表格视图工具栏里修改会写回这一项用户设置，下一次打开任何 CSV 都会沿用。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "test": "npm run compile && node --test \"out/test/*.test.js\"",
    "test:integration": "npm run compile && node out/test/runIntegration.js",
    "package": "vsce package --no-dependencies",
    "install:vsix": "npm run compile && npm run package && code --install-extension dsh-csv-table-0.1.0.vsix --force"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.1",
    "jsdom": "^25.0.1",
    "mocha": "^12.0.2",
    "typescript": "^5.7.2"
  }
}
