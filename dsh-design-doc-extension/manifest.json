{
  "manifest_version": 3,
  "name": "设计文档坐标",
  "version": "0.1.0",
  "description": "在设计文档里悬停任意一段，Ctrl+C 直接复制它的章节坐标（job-10-2|p3），和 DSH 插件、design-map.json 用的是同一套 key。",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "contextMenus",
    "sidePanel",
    "clipboardWrite"
  ],
  "host_permissions": [
    "file:///*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "file:///*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "src/dd-path.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "设计文档坐标",
    "default_icon": {
      "16": "media/icon16.png",
      "32": "media/icon32.png",
      "48": "media/icon48.png",
      "128": "media/icon128.png"
    }
  },
  "icons": {
    "16": "media/icon16.png",
    "32": "media/icon32.png",
    "48": "media/icon48.png",
    "128": "media/icon128.png"
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "commands": {
    "copy-coordinate": {
      "suggested_key": {
        "default": "Alt+C"
      },
      "description": "复制鼠标所在块的坐标"
    }
  }
}
