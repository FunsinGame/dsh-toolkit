{
  "name": "dsh-notes",
  "version": "0.1.0",
  "description": "DSH notes plugin and standalone notes server: markdown notes, attachments, account/password login, offline sync, AI tools and MCP.",
  "type": "module",
  "main": "lib/index.js",
  "icon": "media/icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./media/icon.svg",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-notes-server": "server/bin.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "files": [
    "lib",
    "server",
    "web",
    "media",
    "deploy",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs && node scripts/test-platform.mjs",
    "test": "node scripts/test-server.mjs && node scripts/test-security.mjs && node scripts/test-mcp.mjs && node scripts/test-host.mjs && node scripts/test-client.mjs && node scripts/test-platform.mjs",
    "test:unit": "node scripts/test-server.mjs && node scripts/test-security.mjs && node scripts/test-mcp.mjs",
    "smoke": "node scripts/smoke-server.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:dsh": "node scripts/test-dsh-integration.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "package:dist": "node scripts/package-dist.mjs",
    "server": "node server/bin.js"
  },
  "license": "MIT",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "dompurify": "^3.2.7",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "highlight.js": "^11.11.1",
    "jsdom": "^26.1.0",
    "marked": "^15.0.12",
    "playwright-core": "^1.55.0",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "typescript": "^5.7.2",
    "zod": "^3.24.2"
  }
}
