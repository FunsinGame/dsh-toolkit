# Copy to /etc/dsh-notes/env (root:root, 0600) or set the same variables in
# your service manager. Never commit real tokens or passwords.
DSH_NOTES_DATA_DIR=/var/lib/dsh-notes
DSH_NOTES_HOST=127.0.0.1
DSH_NOTES_PORT=8787
DSH_NOTES_PUBLIC_URL=https://notes.example.com
DSH_NOTES_BEHIND_PROXY=1
# Only the address of the reverse proxy may be trusted for X-Forwarded-*.
DSH_NOTES_TRUSTED_PROXY=127.0.0.1,::1
DSH_NOTES_LOG_LEVEL=info
# Optional: set DSH_NOTES_LOG_FILE=/var/lib/dsh-notes/logs/server.log
# Never set DSH_NOTES_INSECURE_HTTP=1 on a public host.
