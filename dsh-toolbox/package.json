{
  "name": "dsh-toolbox",
  "version": "0.1.0",
  "description": "DSH 工具箱：左侧活动栏一个入口，左侧是工具列表、右侧是工具界面。内置视频逐帧播放器与图片对比两个子工具。",
  "type": "module",
  "main": "lib/index.js",
  "icon": "media/icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./icon": "./media/icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "files": [
    "lib",
    "media",
    "docs/screenshot.png",
    "docs/screenshot-compare.png",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "node --check lib/index.js && node --check lib/client.js",
    "fixtures": "node scripts/make-fixtures.mjs",
    "test:parser": "node scripts/test-parser.mjs",
    "test:client": "node scripts/test-client.mjs",
    "test:e2e": "node scripts/test-e2e.mjs",
    "screenshot": "node scripts/screenshot.mjs",
    "test": "npm run typecheck && npm run build && npm run test:parser && npm run test:client"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "toolbox",
    "video",
    "image",
    "compare"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.9.3"
  }
}

